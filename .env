# =============================================================================
# Zonix Eats — Backend API (Laravel)
# Desarrollo: APP_ENV=local. Producción: APP_ENV=production, APP_DEBUG=false
# =============================================================================

APP_NAME="Zonix Eats"
APP_ENV=local
# APP_ENV=production
APP_KEY=base64:BPp/rPub3jXv6CfiJMw57O1r3+BTe3391T1aTDGtM6Y=
APP_DEBUG=true
APP_URL=http://192.168.27.12:8000

APP_URL_PRODUCTION=https://eats.aiblockweb.com
APP_URL_LOCAL=http://192.168.27.12:8000

# --- Logging ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eats
DB_USERNAME=su
DB_PASSWORD=123

# --- Firebase (FCM, Storage). JSON en storage/app/ o ruta absoluta ---
FIREBASE_CREDENTIALS=firebase-zonix-eats-777.json
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=zonix-eats-777.firebasestorage.app

# --- API: orígenes permitidos (Sanctum cookies + CORS). Incluir IP/host de la API si se accede por red local ---
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,192.168.27.12
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://192.168.27.12:8000

# --- Cache, colas, sesión ---
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (Mailpit en desarrollo) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Pusher (broadcasting). useTLS se deduce de PUSHER_SCHEME en config/broadcasting.php ---
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=2062166
PUSHER_APP_KEY=bbcdf6aa58188e699d64
PUSHER_APP_SECRET=8e4045ea609a30714289
PUSHER_APP_CLUSTER=sa1
PUSHER_SCHEME=https

# --- Zonix: servicios externos y defaults (config/zonix.php) ---
# Routing cascada: ORS (si hay key) → Valhalla → OSRM FOSSGIS → OSRM demo → interpolado
ZONIX_ORS_API_KEY=eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6ImY1ZmM2ZjIwMDI1MTQyYWI4M2E5MzBlOWU0MjZhYjUxIiwiaCI6Im11cm11cjY0In0=
ZONIX_VALHALLA_ROUTE_URL=https://valhalla1.openstreetmap.de/route
ZONIX_OSRM_FOSSGIS_BASE_URL=https://routing.openstreetmap.de/routed-car
ZONIX_OSRM_DEMO_BASE_URL=https://router.project-osrm.org
ZONIX_OSRM_BASE_URL=https://router.project-osrm.org
ZONIX_NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
ZONIX_NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
ZONIX_DEFAULT_DELIVERY_FEE=5.00
ZONIX_DEFAULT_PREPARATION_TIME_MINUTES=12

# Máximo de pedidos activos por comprador (no entregados ni cancelados). 0 = ilimitado.
ZONIX_BUYER_MAX_CONCURRENT_OPEN_ORDERS=7

# Auto-cancelar pending_payment sin pago (artisan zonix:expire-pending-payment-orders).
# Automático solo si corre el scheduler: dev → `php artisan schedule:work` (si usas composer: `composer run schedule-work --timeout=0`).
# En APP_ENV=local el Kernel agenda expiración cada 1 min; en prod/staging cada 5 min + cron `* * * * * php artisan schedule:run`.
# Si la BD existía sin columna: ALTER TABLE orders ADD COLUMN approved_for_payment_at TIMESTAMP NULL AFTER approved_for_payment;
ZONIX_EXPIRE_PENDING_PAYMENT_ENABLED=true
# PRUEBA LOCAL: 2 y 1 min para validar el flujo. En producción usar 1440 y 60 (ver .env.example).
# 0 = desactiva la regla. Default recomendado: 1440 = 24 h desde creación del pedido.
ZONIX_PENDING_PAYMENT_MAX_AGE_MINUTES=2
# 0 = desactiva. Default recomendado: 60 min desde approved_for_payment_at (aprobación del comercio).
ZONIX_PENDING_PAYMENT_AFTER_APPROVAL_MINUTES=1

